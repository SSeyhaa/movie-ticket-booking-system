# ----- DISCOVERY SERVICE
DISCOVERY_SERVICE_NAME=discovery-server
DISCOVERY_HOST=localhost
DISCOVERY_SERVICE_PORT=8761
DISCOVERY_SERVICE_URL=http://${DISCOVERY_HOST}:${DISCOVERY_SERVICE_PORT}/eureka/

# ----- GATEWAY SERVICE
GATEWAY_SERVICE_NAME=api-gateway-service
GATEWAY_SERVICE_HOST=localhost
GATEWAY_SERVICE_PORT=8443
GATEWAY_SERVICE_URL=http://${GATEWAY_SERVICE_HOST}:${GATEWAY_SERVICE_PORT}

# ----- KEYCLOAK SERVER
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://${KEYCLOAK_HOST}:${KEYCLOAK_PORT}
KEYCLOAK_DB=keycloak_db
KEYCLOAK_REALM=movie-ticket-booking-realm
KEYCLOAK_ROLE_SUPER_ADMIN=SUPER_ADMIN
KEYCLOAK_ROLE_USER=USER
KEYCLOAK_USERNAME_SUPER_ADMIN=super-admin
KEYCLOAK_PASSWORD_SUPER_ADMIN=123
KEYCLOAK_EMAIL_SUPER_ADMIN=super.admin@gmail.com
KEYCLOAK_FIRST_NAME_SUPER_ADMIN=super
KEYCLOAK_LAST_NAME_SUPER_ADMIN=admin

# ----- DATABASE SERVER
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ----- KAFKA BROKER SERVER
KAFKA_HOST=localhost
KAFKA_PORT=9094
KAFKA_URL=${KAFKA_HOST}:${KAFKA_PORT}
KAFKA_AUTO_CREATE_TOPICS=true


# ----- MAIL SMTP server
# smtp.gmail.com for real SMTP server
MAIL_HOST=localhost
# 587 for real SMTP server
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
# Enables authentication for real SMTP server
MAIL_PROPERTIES_MAIL_SMTP_AUTH=false

# Enables STARTTLS for real SMTP server
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# STARTTLS is required for real SMTP server
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=false

# ----- MOVIE SERVICE
